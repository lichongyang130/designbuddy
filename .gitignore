# Installed dependencies
node_modules/

# Build output
dist/
build/
coverage/

# Local caches and logs
.cache/
*.log
# Curated verification logs are reproducible evidence, not runtime logs
!docs/verification/**/logs/*.log

# Local configuration and secrets
.env
.env.*
!.env.example
!.env.*.example

# Runtime databases (local user data)
/data/*.sqlite
/data/*.sqlite-shm
/data/*.sqlite-wal

# Browser test sessions and generated reports
/apps/web/playwright/
/apps/web/test-results/
/apps/web/playwright-report/

# Uploaded runtime attachments (not source assets)
/data/assets/

# Local maintenance-only Python environment (font instance tooling)
.venv/
