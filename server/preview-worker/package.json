{
  "name": "@designbuddy/preview-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated Docker-based preview runtime worker",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && npm run verify:types && node --test dist/*.test.js",
    "test:e2e": "tsx --test e2e/*.e2e.test.ts",
    "verify:types": "tsc -p tsconfig.verify.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "playwright": "^1.53.0",
    "express": "^4.21.2",
    "@types/express": "^4.17.21"
  }
}
