# Use a randomly generated secret with at least 32 characters.
PREVIEW_RUNTIME_TOKEN=replace-with-a-long-random-secret
PREVIEW_WORKER_ID=designbuddy-preview-worker

# Public HTTPS origin used by the browser for /p/<sessionId>/ previews.
PUBLIC_PREVIEW_ORIGIN=https://preview.example.com

# On Linux, the worker and Docker daemon must see this same absolute path.
PREVIEW_WORKSPACE_ROOT=/var/lib/designbuddy-preview

# Bind published ports to a host interface reachable by the worker but not public.
PREVIEW_BIND_HOST=127.0.0.1
PREVIEW_UPSTREAM_HOST=127.0.0.1
PREVIEW_HOST_PORT_START=41000
PREVIEW_HOST_PORT_END=41999

PREVIEW_MEMORY_LIMIT=512m
PREVIEW_CPU_LIMIT=1
PREVIEW_PIDS_LIMIT=128
PREVIEW_MAX_SESSIONS=8
PREVIEW_MAX_FILES=500
PREVIEW_MAX_TOTAL_BYTES=5242880
PREVIEW_STARTUP_TIMEOUT_MS=180000
PREVIEW_SESSION_TTL_MS=7200000

# Keep the API bound to loopback; publish previews through a TLS reverse proxy.
HOST=127.0.0.1
PORT=8080
