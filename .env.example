# DesignBuddy local development environment.
# Copy to .env / .env.local (both are loaded automatically, never commit them).

# Third-party sign-in. Leave a pair empty to disable that provider; the login
# page then shows "未配置" on its button instead of starting the flow.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Register these exact redirect URIs in the provider console (replace the host
# with your own when it changes, e.g. the preview host):
#   http://127.0.0.1:5173/api/auth/oauth/google/callback
#   http://127.0.0.1:5173/api/auth/oauth/github/callback

# Public origin override (used for OAuth redirects and CSRF checks).
# DESIGNBUDDY_PUBLIC_ORIGIN=

# Server ports.
# DESIGNBUDDY_PORT=8787
# DESIGNBUDDY_WEB_PORT=5173
