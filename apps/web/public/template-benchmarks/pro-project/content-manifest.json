  "schemaVersion": 1,
  "contentHash": "aa2b5efd0e6b3e0e7f19477bb57d797ef6c95214299c8f840c3d6a0a120760f2",
  "nodes": [
    {
      "id": "section-0",
      "text": "目标与背景"
    },
    {
      "id": "body-0-0",
      "text": "把网站改版从页面交付变成有验收依据的项目"
    },
    {
      "id": "body-0-1",
      "text": "适用对象：委托方产品负责人、设计负责人、实施与验收人员。"
    },
    {
      "id": "body-0-2",
      "text": "目标：形成一套可追溯的需求、页面实现、测试与交付文件。"
    },
    {
      "id": "body-0-3",
      "text": "样例项目为虚构的品牌网站改版；本方案不是合同或已批准预算。"
    },
    {
      "id": "body-0-4",
      "text": "启动时需确认项目名称、品牌材料、目标用户、决策人和现有系统访问范围。"
    },
    {
      "id": "section-1",
      "text": "范围与不含项"
    },
    {
      "id": "body-1-0",
      "text": "边界先于排期"
    },
    {
      "id": "body-1-1",
      "text": "包含：首页、产品介绍、案例结构、联系表单前端与响应式规范。"
    },
    {
      "id": "body-1-2",
      "text": "包含：可编辑内容、源代码、部署说明、素材清单和测试记录。"
    },
    {
      "id": "body-1-3",
      "text": "不含：支付、CRM 对接、真实邮件发送、法律审查与未经授权的数据迁移。"
    },
    {
      "id": "body-1-4",
      "text": "新增页面、第三方接口或语言版本进入变更流程，不默认为原范围内工作。"
    },
    {
      "id": "section-2",
      "text": "交付物与关卡"
    },
    {
      "id": "body-2-0",
      "text": "每个关卡都留下可审阅的证据"
    },
    {
      "id": "body-2-1",
      "text": "G1 需求确认：需求清单、页面地图、输入材料与未决问题。"
    },
    {
      "id": "body-2-2",
      "text": "G2 设计确认：关键页面、组件规则、移动端与异常状态。"
    },
    {
      "id": "body-2-3",
      "text": "G3 实施交付：源码、测试、部署、回退与交接文件。"
    },
    {
      "id": "body-2-4",
      "text": "关卡表示依赖顺序，不是实际完成状态。具体日期由资源与依赖确认后填写。"
    },
    {
      "id": "deliverables-caption",
      "text": "交付与验收对应表"
    },
    {
      "id": "deliverables-h0",
      "text": "交付物"
    },
    {
      "id": "deliverables-h1",
      "text": "确认依据"
    },
    {
      "id": "deliverables-h2",
      "text": "确认岗位"
    },
    {
      "id": "deliverables-r0c0",
      "text": "需求与页面地图"
    },
    {
      "id": "deliverables-r0c1",
      "text": "范围清单逐项对应"
    },
    {
      "id": "deliverables-r0c2",
      "text": "委托方负责人"
    },
    {
      "id": "deliverables-r1c0",
      "text": "设计与实现"
    },
    {
      "id": "deliverables-r1c1",
      "text": "页面预览与功能测试记录"
    },
    {
      "id": "deliverables-r1c2",
      "text": "设计/实施负责人"
    },
    {
      "id": "deliverables-r2c0",
      "text": "部署与交接"
    },
    {
      "id": "deliverables-r2c1",
      "text": "构建、回退、备份说明"
    },
    {
      "id": "deliverables-r2c2",
      "text": "运维/验收负责人"
    },
    {
      "id": "deliverables-scope",
      "text": "虚构网站改版项目；列出交付类别，不代表已完成。"
    },
    {
      "id": "deliverables-calculation",
      "text": "非数值表格，不作总计。"
    },
    {
      "id": "section-3",
      "text": "角色与沟通"
    },
    {
      "id": "body-3-0",
      "text": "责任按岗位描述，避免虚构人员承诺"
    },
    {
      "id": "body-3-1",
      "text": "委托方负责人：确认范围、材料真实性和最终验收结论。"
    },
    {
      "id": "body-3-2",
      "text": "交付负责人：维护版本、风险、问题与变更记录，安排评审。"
    },
    {
      "id": "body-3-3",
      "text": "实施与测试人员：提交实现证据、复现步骤、缺陷修复和回归结果。"
    },
    {
      "id": "body-3-4",
      "text": "每次评审记录版本、结论、未决项、责任岗位和下一次复核条件。"
    },
    {
      "id": "section-4",
      "text": "变更管理"
    },
    {
      "id": "body-4-0",
      "text": "先记录影响，再批准实施"
    },
    {
      "id": "body-4-1",
      "text": "提交：记录变更原因、原需求、新需求与提出人岗位。"
    },
    {
      "id": "body-4-2",
      "text": "评估：说明内容、设计、实现、测试与时间/费用影响。"
    },
    {
      "id": "body-4-3",
      "text": "确认：由授权负责人批准或拒绝；批准前不覆盖已确认基线。"
    },
    {
      "id": "body-4-4",
      "text": "变更表字段：编号、日期、范围、影响、决定、批准岗位、实施版本。"
    },
    {
      "id": "section-5",
      "text": "风险与应对"
    },
    {
      "id": "body-5-0",
      "text": "明确触发信号与升级方式"
    },
    {
      "id": "body-5-1",
      "text": "材料延迟：关键文案或授权缺失，暂停相应页面定稿并登记阻断。"
    },
    {
      "id": "body-5-2",
      "text": "接口不可用：保留错误态与模拟数据标识，不伪装真实提交成功。"
    },
    {
      "id": "body-5-3",
      "text": "字体和素材：许可不明或缺字时更换来源，随后重新渲染与复核。"
    },
    {
      "id": "body-5-4",
      "text": "敏感数据不写入公开样例或日志。需要生产权限时另行通过安全渠道授予。"
    },
    {
      "id": "section-6",
      "text": "验收条件"
    },
    {
      "id": "body-6-0",
      "text": "硬性失败不能被综合评分抵消"
    },
    {
      "id": "body-6-1",
      "text": "内容：已确认需求逐项映射到页面，不存在无意义占位或遗漏。"
    },
    {
      "id": "body-6-2",
      "text": "功能：主流程、失败与取消路径可执行，保存与重新打开行为一致。"
    },
    {
      "id": "body-6-3",
      "text": "交付：源文件可开、导出与预览同版、素材许可齐全；严重错误修复后回归。"
    },
    {
      "id": "body-6-4",
      "text": "业务负责人确认语义与范围；测试确认执行证据。验收框未勾选不表示通过。"
    },
    {
      "id": "section-7",
      "text": "交接与维护"
    },
    {
      "id": "body-7-0",
      "text": "交付后也能找到版本、数据与负责人"
    },
    {
      "id": "body-7-1",
      "text": "交接清单：源码版本、构建命令、环境变量名、部署与回退步骤。"
    },
    {
      "id": "body-7-2",
      "text": "维护清单：备份、恢复演练、依赖更新、域名/证书与问题反馈入口。"
    },
    {
      "id": "body-7-3",
      "text": "来源声明：本文件为原创方法样例，不含真实客户数据或商业承诺。"
    },
    {
      "id": "body-7-4",
      "text": "访问凭据在服务器 Secret 中保存，不附在本文件或聊天记录里。"
    }
  ],
